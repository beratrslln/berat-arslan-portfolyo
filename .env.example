# Backend hazır olduğunda doldurun. Boş kalırsa site src/icerik içindeki yerel veriyle çalışır
# ve proje formu e-posta uygulamasını açar.

# Canlı ortamda API'nin adresi (ör. https://api.beratarslan.com). Boş: aynı alan adı.
VITE_API_URL=

# true olursa içerik ve form API üzerinden çalışır.
VITE_API_AKTIF=false

# Yalnız geliştirme: npm run dev sırasında /api isteklerinin gideceği yerel backend.
VITE_API_PROXY=
